<script>
  // ============================================================
  // Active nav highlight
  // ============================================================
  const navLinks = document.querySelectorAll('.nav-links a');
  const sections = ['home', 'about', 'photos', 'videos', 'contact'].map(id => document.getElementById(id));

  function updateActiveNav() {
    const scrollPos = window.scrollY + 80;
    let current = 'home';
    sections.forEach(sec => {
      if (sec && sec.offsetTop <= scrollPos) current = sec.id;
    });
    navLinks.forEach(link => {
      link.classList.toggle('active', link.getAttribute('href') === '#' + current);
    });
  }
  window.addEventListener('scroll', updateActiveNav);

  // ============================================================
  // Photos — file upload, base64, localStorage
  // ============================================================
  const photosGrid = document.getElementById('photosGrid');

  function loadPhotos() {
    try { return JSON.parse(localStorage.getItem('dmb_photos') || '[]'); }
    catch { return []; }
  }

  function savePhotos(arr) {
    try { localStorage.setItem('dmb_photos', JSON.stringify(arr)); }
    catch (e) {
      alert('Storage limit reached — try removing older photos. Browser localStorage caps around 5-10MB total.');
    }
  }

  function renderPhotos() {
    const list = loadPhotos();
    photosGrid.innerHTML = '';
    if (list.length === 0) {
      photosGrid.innerHTML = '<p class="photos-empty">No photos yet. Use the upload form above to add your first.</p>';
      return;
    }
    list.forEach((p, idx) => {
      const card = document.createElement('div');
      card.className = 'photo-card';
      card.innerHTML = `
        <img src="${p.data}" alt="${p.caption || 'Photo'}" onclick="openModal('${p.data.replace(/'/g, "\\'")}')" />
        <div class="photo-meta">
          <div class="caption">${p.caption || '(no caption)'}<br><small style="color: var(--text-light);">Added ${p.added}</small></div>
          <div class="photo-actions">
            <button onclick="removePhoto(${idx})">Remove</button>
          </div>
        </div>
      `;
      photosGrid.appendChild(card);
    });
  }

  function addPhoto() {
    const file = document.getElementById('photoFile').files[0];
    const caption = document.getElementById('photoCaption').value.trim();
    if (!file) {
      alert('Pick a photo file first.');
      return;
    }
    if (!file.type.startsWith('image/')) {
      alert('That file is not an image.');
      return;
    }
    const reader = new FileReader();
    reader.onload = function(e) {
      const list = loadPhotos();
      const today = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      list.unshift({ data: e.target.result, caption, added: today });
      savePhotos(list);
      document.getElementById('photoFile').value = '';
      document.getElementById('photoCaption').value = '';
      renderPhotos();
    };
    reader.readAsDataURL(file);
  }

  function removePhoto(idx) {
    if (!confirm('Remove this photo?')) return;
    const list = loadPhotos();
    list.splice(idx, 1);
    savePhotos(list);
    renderPhotos();
  }

  function openModal(src) {
    document.getElementById('modalImg').src = src;
    document.getElementById('photoModal').classList.add('active');
  }

  function closeModal() {
    document.getElementById('photoModal').classList.remove('active');
  }

  // ESC to close modal
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();
  });

  // ============================================================
  // Videos — YouTube embed, localStorage
  // ============================================================
  const videosGrid = document.getElementById('videosGrid');

  function getYouTubeId(url) {
    const patterns = [
      /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/,
      /youtube\.com\/shorts\/([a-zA-Z0-9_-]{11})/
    ];
    for (const p of patterns) {
      const m = url.match(p);
      if (m) return m[1];
    }
    return null;
  }

  function loadVideos() {
    try { return JSON.parse(localStorage.getItem('dmb_videos') || '[]'); }
    catch { return []; }
  }

  function saveVideos(arr) {
    try { localStorage.setItem('dmb_videos', JSON.stringify(arr)); }
    catch {}
  }

  function renderVideos() {
    const list = loadVideos();
    videosGrid.innerHTML = '';
    if (list.length === 0) {
      videosGrid.innerHTML = '<p class="videos-empty">No videos yet. Paste a YouTube URL above to add your first.</p>';
      return;
    }
    list.forEach((v, idx) => {
      const card = document.createElement('div');
      card.className = 'video-card';
      card.innerHTML = `
        <iframe src="https://www.youtube.com/embed/${v.id}" allowfullscreen></iframe>
        <div class="video-meta">
          <span>Added ${v.added}</span>
          <button onclick="removeVideo(${idx})">Remove</button>
        </div>
      `;
      videosGrid.appendChild(card);
    });
  }

  function addVideo() {
    const input = document.getElementById('videoUrl');
    const url = input.value.trim();
    if (!url) return;
    const id = getYouTubeId(url);
    if (!id) {
      alert('Could not parse a YouTube ID from that URL. Try a standard youtube.com/watch?v=... or youtu.be/... link.');
      return;
    }
    const list = loadVideos();
    const today = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    list.unshift({ id, added: today });
    saveVideos(list);
    input.value = '';
    renderVideos();
  }

  function removeVideo(idx) {
    const list = loadVideos();
    list.splice(idx, 1);
    saveVideos(list);
    renderVideos();
  }

  // Initial render
  renderPhotos();
  renderVideos();

  // ============================================================
  // Email signup — submit via fetch, show inline success
  // ============================================================
  const signupForm = document.getElementById('signupForm');
  const signupSuccess = document.getElementById('signupSuccess');
  if (signupForm) {
    signupForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const formData = new FormData(signupForm);
      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString()
        });
        if (response.ok) {
          signupForm.style.display = 'none';
          signupSuccess.classList.add('active');
        } else {
          alert('Something went wrong. Please try again or email psycd007@gmail.com directly.');
        }
      } catch (err) {
        alert('Network issue. Please try again or email psycd007@gmail.com directly.');
      }
    });
  }
</script>
