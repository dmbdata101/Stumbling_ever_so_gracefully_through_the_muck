<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>D. Michael Brown</title>
<style>
  /* ============================================================
     Neutral palette — beige/gray/black/slate-blue, no purples
     ============================================================ */
  :root {
    --bg: #faf7f2;           /* warm off-white */
    --bg-alt: #f1ece4;       /* slightly darker beige */
    --bg-card: #ffffff;
    --text: #1a1a1a;
    --text-muted: #5a5a5a;
    --text-light: #8a8a8a;
    --accent: #3b5267;       /* slate blue */
    --accent-dark: #2a3b4a;
    --border: #d8d2c5;
    --border-light: #e8e2d5;
    --shadow: 0 1px 3px rgba(0,0,0,0.04), 0 1px 2px rgba(0,0,0,0.06);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    font-size: 16px;
  }

  /* ============================================================
     Header — sticky nav
     ============================================================ */
  header {
    position: sticky;
    top: 0;
    background: var(--accent-dark);
    color: var(--bg);
    padding: 14px 32px;
    z-index: 100;
    box-shadow: var(--shadow);
  }
  header nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  header .brand {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  header .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
  }
  header .nav-links a {
    color: var(--bg);
    text-decoration: none;
    font-size: 14px;
    opacity: 0.85;
    transition: opacity 0.2s;
    padding: 6px 0;
  }
  header .nav-links a:hover {
    opacity: 1;
  }
  header .nav-links a.active {
    opacity: 1;
    border-bottom: 2px solid var(--bg);
  }

  /* ============================================================
     Home / Hero — office image background with dark overlay
     ============================================================ */
  .hero {
    position: relative;
    background-image:
      linear-gradient(135deg, rgba(20, 25, 35, 0.72) 0%, rgba(35, 40, 50, 0.65) 100%),
      url('office_bg.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 140px 32px 120px;
    text-align: center;
    border-bottom: 1px solid var(--border-light);
    color: #f5efe2;
  }
  .hero h1 {
    font-family: "Lucida Handwriting", "Lucida Calligraphy", "Apple Chancery", cursive;
    font-size: 64px;
    font-weight: 400;
    letter-spacing: 0.5px;
    color: #f5efe2;
    margin-bottom: 8px;
    text-shadow: 0 2px 14px rgba(0,0,0,0.5);
    line-height: 1.2;
  }
  .hero .subtitle {
    font-family: "Lucida Handwriting", "Apple Chancery", cursive;
    font-size: 24px;
    color: #c8b48f;
    margin-bottom: 28px;
    letter-spacing: 1.5px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    font-style: italic;
  }
  .hero .tagline {
    font-size: 20px;
    color: #e8dfd0;
    max-width: 720px;
    margin: 0 auto 28px;
    line-height: 1.55;
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }
  .hero .meta {
    font-size: 14px;
    color: #c8b48f;
    letter-spacing: 0.3px;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }

  /* ============================================================
     Sections
     ============================================================ */
  section {
    padding: 80px 32px;
    max-width: 1100px;
    margin: 0 auto;
  }
  section h2 {
    font-size: 30px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
    letter-spacing: -0.2px;
  }
  section .section-subtitle {
    color: var(--text-muted);
    font-size: 15px;
    margin-bottom: 36px;
  }

  /* ============================================================
     About — horizontal vignette: darker cream sides → light center
     ============================================================ */
  .about {
    background: linear-gradient(
      90deg,
      #b8ad95 0%,
      #b8ad95 8%,
      #c2b89e 16%,
      #cdc2a6 24%,
      #d6ccae 32%,
      #ded5b9 40%,
      #e6dcc4 50%,
      #ded5b9 60%,
      #d6ccae 68%,
      #cdc2a6 76%,
      #c2b89e 84%,
      #b8ad95 92%,
      #b8ad95 100%
    );
    position: relative;
  }
  .about-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    max-width: 800px;
    margin: 0 auto;
    border-left: 1px solid var(--border);
    padding-left: 36px;
  }
  .about-content p {
    color: var(--text);
    font-size: 16px;
    line-height: 1.75;
  }
  .about-content p.italic {
    font-style: italic;
    color: var(--text-muted);
    border-left: 3px solid var(--border);
    padding-left: 18px;
    font-size: 17px;
  }
  .about-content h3 {
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
    margin-top: 18px;
    margin-bottom: 4px;
    position: relative;
  }
  .about-content h3::before {
    content: attr(data-chapter);
    display: block;
    font-family: "Lucida Handwriting", "Apple Chancery", cursive;
    font-size: 26px;
    font-weight: 400;
    color: #000;
    letter-spacing: 1px;
    margin-bottom: 10px;
    opacity: 1;
  }
  .chapter-divider {
    text-align: center;
    margin: 36px 0 18px 0;
    color: var(--accent);
    opacity: 0.4;
    font-size: 18px;
    letter-spacing: 8px;
  }
  .chapter-divider::before, .chapter-divider::after {
    content: "";
    display: inline-block;
    width: 60px;
    height: 1px;
    background: var(--border);
    vertical-align: middle;
    margin: 0 14px;
  }

  /* ============================================================
     Photos
     ============================================================ */
  .photos {
    background: var(--bg-alt);
  }
  .photo-input {
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: 6px;
    padding: 24px;
    margin-bottom: 28px;
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .photo-input label {
    font-weight: 600;
    color: var(--text-muted);
    margin-right: 6px;
  }
  .photo-input input[type="file"] {
    flex: 1;
    padding: 8px;
    font-family: inherit;
    font-size: 14px;
    color: var(--text);
    min-width: 240px;
  }
  .photo-input input[type="text"] {
    flex: 1;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    font-size: 14px;
    min-width: 200px;
  }
  .photo-input input[type="text"]:focus {
    outline: none;
    border-color: var(--accent);
  }
  .photo-input button {
    padding: 12px 22px;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .photo-input button:hover {
    background: var(--accent-dark);
  }
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .photo-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow);
    position: relative;
  }
  .photo-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    cursor: pointer;
  }
  .photo-card .photo-meta {
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  .photo-card .caption {
    flex: 1;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .photo-card .photo-actions button {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 4px 10px;
    font-size: 12px;
    border-radius: 3px;
    cursor: pointer;
    font-family: inherit;
  }
  .photo-card .photo-actions button:hover {
    background: var(--bg-alt);
  }
  .photos-empty {
    color: var(--text-light);
    text-align: center;
    padding: 40px 0;
    font-style: italic;
    grid-column: 1 / -1;
  }
  .photo-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 32px;
  }
  .photo-modal.active { display: flex; }
  .photo-modal img {
    max-width: 95%;
    max-height: 90vh;
    object-fit: contain;
    box-shadow: 0 8px 30px rgba(0,0,0,0.5);
  }
  .photo-modal .close-modal {
    position: absolute;
    top: 24px;
    right: 32px;
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    font-size: 22px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
  }

  /* ============================================================
     Videos
     ============================================================ */
  .videos {
    background: var(--bg);
  }
  .video-input {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    max-width: 700px;
  }
  .video-input input {
    flex: 1;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-card);
    color: var(--text);
    font-family: inherit;
    font-size: 14px;
  }
  .video-input input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .video-input button {
    padding: 12px 22px;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
  }
  .video-input button:hover {
    background: var(--accent-dark);
  }
  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 16px;
  }
  .video-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .video-card iframe {
    width: 100%;
    aspect-ratio: 16/9;
    border: 0;
  }
  .video-card .video-meta {
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .video-card .video-meta span {
    font-size: 12px;
    color: var(--text-light);
  }
  .video-card .video-meta button {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 4px 10px;
    font-size: 12px;
    border-radius: 3px;
    cursor: pointer;
    font-family: inherit;
  }
  .video-card .video-meta button:hover {
    background: var(--bg-alt);
  }
  .videos-empty {
    color: var(--text-light);
    text-align: center;
    padding: 40px 0;
    font-style: italic;
  }

  /* ============================================================
     Contact section
     ============================================================ */
  .contact-section {
    background: var(--bg-alt);
  }
  .contact-section .invitation {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 36px;
    color: var(--text-muted);
    font-size: 17px;
    line-height: 1.6;
  }
  .social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    max-width: 800px;
    margin: 0 auto 36px;
  }
  .social-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 26px 24px;
    text-align: center;
    text-decoration: none;
    color: var(--text);
    box-shadow: var(--shadow);
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .social-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
  }
  .social-card .icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .social-card .icon svg {
    width: 100%;
    height: 100%;
  }
  .social-card.linkedin .icon { color: #0A66C2; }
  .social-card.instagram .icon { color: #E1306C; }
  .social-card.facebook .icon { color: #1877F2; }
  .social-card .platform {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.3px;
    margin-top: 4px;
  }
  .social-card .handle {
    font-size: 13px;
    color: var(--text-muted);
  }
  .direct-contact {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 24px;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .direct-contact h3 {
    font-size: 14px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 14px;
    font-weight: 600;
  }
  .direct-contact a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 16px;
  }
  .direct-contact a:hover {
    text-decoration: underline;
  }
  .direct-contact .email-line {
    margin-bottom: 12px;
    font-size: 16px;
  }
  .direct-contact .phone-line {
    color: var(--text);
    font-size: 15px;
    letter-spacing: 0.2px;
  }
  .direct-contact .phone-line .sep {
    color: var(--text-light);
    margin: 0 8px;
  }
  /* Email signup */
  .signup-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 28px 24px;
    max-width: 640px;
    margin: 24px auto 0;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .signup-card h3 {
    font-family: "Lucida Handwriting", "Apple Chancery", cursive;
    font-size: 26px;
    color: #000;
    margin-bottom: 6px;
    letter-spacing: 0.5px;
  }
  .signup-card .signup-blurb {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 18px;
    line-height: 1.55;
  }
  .signup-form {
    display: flex;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto;
    flex-wrap: wrap;
    justify-content: center;
  }
  .signup-form input[type="email"] {
    flex: 1;
    min-width: 220px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    font-size: 14px;
  }
  .signup-form input[type="email"]:focus {
    outline: none;
    border-color: var(--accent);
  }
  .signup-form button {
    padding: 12px 24px;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .signup-form button:hover {
    background: var(--accent-dark);
  }
  .signup-form .hp {
    position: absolute;
    left: -9999px;
    top: -9999px;
  }
  .signup-success {
    display: none;
    color: var(--text);
    font-size: 16px;
    padding: 16px;
    background: var(--bg-alt);
    border-radius: 4px;
    margin-top: 12px;
  }
  .signup-success.active {
    display: block;
  }
  .signup-tiny {
    font-size: 12px;
    color: var(--text-light);
    margin-top: 12px;
    font-style: italic;
  }

  /* ============================================================
     Footer (minimal)
     ============================================================ */
  footer {
    background: var(--accent-dark);
    color: #f5efe2;
    padding: 32px 32px 28px;
    text-align: center;
  }
  footer .meta {
    font-size: 13px;
    color: #f5efe2;
    opacity: 0.85;
    letter-spacing: 0.3px;
  }

  /* ============================================================
     Mobile
     ============================================================ */
  @media (max-width: 768px) {
    header { padding: 12px 16px; }
    header .nav-links { gap: 16px; }
    header .nav-links a { font-size: 13px; }
    .hero { padding: 70px 20px 60px; }
    .hero h1 { font-size: 36px; }
    .hero .tagline { font-size: 17px; }
    section { padding: 56px 20px; }
    section h2 { font-size: 24px; }
    .photos-grid, .videos-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
